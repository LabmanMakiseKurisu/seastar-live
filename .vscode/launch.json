{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Amadeus_Debug",
        "type": "cppdbg",
        "request": "launch",
        "program": "${workspaceFolder}/build/release/server",
        "args": [
          // "--json", "/1.json"
        ],
        "stopAtEntry": false,
        "cwd": "${workspaceFolder}/build/release",
        "environment": [],
        "externalConsole": false,
        "MIMode": "gdb",
        "setupCommands": [
            {
                "description": "为 gdb 启用美化打印",
                "text": "-enable-pretty-printing",
                "ignoreFailures": true
            }
        ],
        "preLaunchTask": "build",
        "miDebuggerPath": "/usr/bin/gdb"
      }
    ]
  }
  